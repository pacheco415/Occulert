<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Occulert™ — AI Drowsiness Detection for Every Driver</title>
<meta name="description" content="Occulert uses AI eye-tracking to detect driver drowsiness in real-time and alerts you before accidents happen. Works on iPhone, Samsung, and all Android devices."/>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
*{margin:0;padding:0;box-sizing:border-box;}
html{scroll-behavior:smooth;}
 
:root{
  --dark:#0a0e1a;
  --dark2:#0f1525;
  --dark3:#141c30;
  --card:#161e32;
  --border:#1e2d4a;
  --border2:#243458;
  --accent:#2563eb;
  --accent2:#3b82f6;
  --cyan:#06b6d4;
  --green:#10b981;
  --warn:#f59e0b;
  --danger:#ef4444;
  --text:#e2e8f0;
  --text2:#94a3b8;
  --text3:#64748b;
  --white:#ffffff;
  --radius:12px;
}
 
body{
  background:var(--dark);
  color:var(--text);
  font-family:'Inter',sans-serif;
  overflow-x:hidden;
  line-height:1.6;
}
 
/* NOISE TEXTURE */
body::before{
  content:'';
  position:fixed;
  inset:0;
  opacity:0.018;
  background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E");
  pointer-events:none;
  z-index:9999;
}
 
/* NAV */
nav{
  position:fixed;top:0;left:0;right:0;z-index:500;
  padding:0 40px;
  height:70px;
  display:flex;align-items:center;justify-content:space-between;
  background:rgba(10,14,26,0.92);
  backdrop-filter:blur(24px);
  border-bottom:1px solid var(--border);
}
 
.logo{display:flex;align-items:center;gap:10px;text-decoration:none;}
.logo-mark{
  width:38px;height:38px;
  background:linear-gradient(135deg,var(--accent),var(--cyan));
  border-radius:10px;
  display:flex;align-items:center;justify-content:center;
  box-shadow:0 0 20px rgba(37,99,235,0.4);
}
.logo-mark svg{width:22px;height:22px;}
.logo-text{
  font-size:20px;font-weight:800;
  color:var(--white);letter-spacing:0.5px;
}
.logo-tm{font-size:10px;vertical-align:super;color:var(--text3);font-weight:400;}
 
.nav-center{display:flex;gap:8px;}
.nav-center a{
  padding:8px 16px;
  color:var(--text2);
  text-decoration:none;
  font-size:14px;font-weight:500;
  border-radius:8px;
  transition:all 0.15s;
}
.nav-center a:hover{color:var(--white);background:rgba(255,255,255,0.05);}
 
.nav-right{display:flex;align-items:center;gap:12px;}
.nav-btn{
  padding:9px 20px;
  font-size:14px;font-weight:600;
  border-radius:8px;
  text-decoration:none;
  transition:all 0.15s;
  font-family:'Inter',sans-serif;
}
.nav-btn.ghost{
  color:var(--text2);
  border:1px solid var(--border2);
  background:transparent;
}
.nav-btn.ghost:hover{color:var(--white);border-color:var(--border2);}
.nav-btn.solid{
  color:var(--white);
  background:var(--accent);
  border:none;
  cursor:pointer;
}
.nav-btn.solid:hover{background:#1d4ed8;box-shadow:0 4px 20px rgba(37,99,235,0.4);}
 
/* HERO */
.hero{
  padding:140px 40px 100px;
  max-width:1280px;margin:0 auto;
  display:grid;grid-template-columns:1fr 1fr;
  gap:80px;align-items:center;
}
 
.hero-left{}
 
.hero-badge{
  display:inline-flex;align-items:center;gap:8px;
  background:rgba(37,99,235,0.1);
  border:1px solid rgba(37,99,235,0.3);
  border-radius:100px;
  padding:6px 14px 6px 8px;
  margin-bottom:28px;
}
.badge-pill{
  background:var(--accent);
  color:var(--white);
  font-size:10px;font-weight:700;
  letter-spacing:1px;
  padding:3px 8px;
  border-radius:100px;
  text-transform:uppercase;
}
.badge-text{font-size:13px;color:var(--accent2);}
 
h1{
  font-size:clamp(42px,5vw,64px);
  font-weight:900;
  line-height:1.08;
  letter-spacing:-2px;
  color:var(--white);
  margin-bottom:24px;
}
h1 .grad{
  background:linear-gradient(135deg,#60a5fa,#06b6d4);
  -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;
}
 
.hero-desc{
  font-size:17px;color:var(--text2);
  line-height:1.7;margin-bottom:36px;max-width:480px;
}
 
.hero-actions{display:flex;gap:12px;flex-wrap:wrap;margin-bottom:48px;}
 
.btn{
  padding:14px 28px;
  font-size:15px;font-weight:600;
  border-radius:10px;
  text-decoration:none;
  transition:all 0.15s;
  display:inline-flex;align-items:center;gap:8px;
  font-family:'Inter',sans-serif;
  cursor:pointer;border:none;
}
.btn-blue{
  background:var(--accent);color:var(--white);
  box-shadow:0 4px 24px rgba(37,99,235,0.3);
}
.btn-blue:hover{background:#1d4ed8;transform:translateY(-1px);box-shadow:0 8px 32px rgba(37,99,235,0.4);}
.btn-outline{
  background:transparent;color:var(--text);
  border:1px solid var(--border2);
}
.btn-outline:hover{border-color:var(--text3);color:var(--white);}
 
.hero-trust{display:flex;align-items:center;gap:20px;}
.trust-divider{width:1px;height:28px;background:var(--border);}
.trust-item{display:flex;align-items:center;gap:8px;}
.trust-icon{
  width:32px;height:32px;border-radius:8px;
  background:var(--card);border:1px solid var(--border);
  display:flex;align-items:center;justify-content:center;
  font-size:16px;
}
.trust-text{font-size:12px;color:var(--text3);line-height:1.3;}
.trust-text strong{color:var(--text);display:block;}
 
/* HERO RIGHT — App preview */
.hero-right{position:relative;}
 
.app-preview{
  background:var(--dark2);
  border:1px solid var(--border);
  border-radius:20px;
  overflow:hidden;
  box-shadow:0 40px 80px rgba(0,0,0,0.5),0 0 0 1px rgba(255,255,255,0.04);
}
 
.app-topbar{
  background:var(--dark3);
  padding:14px 20px;
  display:flex;align-items:center;justify-content:space-between;
  border-bottom:1px solid var(--border);
}
 
.app-logo-row{display:flex;align-items:center;gap:8px;}
.app-logo-icon{
  width:28px;height:28px;
  background:linear-gradient(135deg,var(--accent),var(--cyan));
  border-radius:7px;
  display:flex;align-items:center;justify-content:center;
}
.app-logo-icon svg{width:16px;height:16px;}
.app-logo-name{font-size:14px;font-weight:700;color:var(--white);}
 
.app-status-pill{
  display:flex;align-items:center;gap:6px;
  background:rgba(16,185,129,0.1);
  border:1px solid rgba(16,185,129,0.25);
  border-radius:100px;
  padding:4px 12px;
  font-size:11px;font-weight:600;
  color:var(--green);
  letter-spacing:0.5px;
}
.pulse{width:6px;height:6px;border-radius:50%;background:var(--green);animation:pulse 2s infinite;}
@keyframes pulse{0%,100%{opacity:1;box-shadow:0 0 0 0 rgba(16,185,129,0.4);}50%{opacity:0.7;box-shadow:0 0 0 4px rgba(16,185,129,0);}}
 
.cam-area{
  background:#000;
  height:220px;
  position:relative;
  overflow:hidden;
  display:flex;align-items:center;justify-content:center;
}
 
.cam-gradient{
  position:absolute;inset:0;
  background:radial-gradient(ellipse at center,rgba(37,99,235,0.08) 0%,transparent 70%);
}
 
.cam-eye-wrap{position:relative;z-index:1;}
 
.cam-eye{
  width:120px;
  animation:eyeAnim 5s ease-in-out infinite;
}
 
@keyframes eyeAnim{
  0%,40%,60%,100%{transform:scaleY(1);}
  50%{transform:scaleY(0.08);}
}
 
.cam-corners{position:absolute;inset:12px;}
.cam-corner{position:absolute;width:16px;height:16px;border-color:rgba(37,99,235,0.6);border-style:solid;}
.cam-corner.tl{top:0;left:0;border-width:2px 0 0 2px;border-radius:2px 0 0 0;}
.cam-corner.tr{top:0;right:0;border-width:2px 2px 0 0;border-radius:0 2px 0 0;}
.cam-corner.bl{bottom:0;left:0;border-width:0 0 2px 2px;border-radius:0 0 0 2px;}
.cam-corner.br{bottom:0;right:0;border-width:0 2px 2px 0;border-radius:0 0 2px 0;}
 
.scan-line{
  position:absolute;left:0;right:0;height:1px;
  background:linear-gradient(90deg,transparent,rgba(6,182,212,0.5),transparent);
  animation:scanLine 3s ease-in-out infinite;
}
@keyframes scanLine{0%{top:10%;opacity:0;}10%{opacity:1;}90%{opacity:1;}100%{top:90%;opacity:0;}}
 
.app-metrics{
  display:grid;grid-template-columns:1fr 1fr 1fr;
  gap:1px;background:var(--border);
}
.metric{
  background:var(--dark2);
  padding:14px 16px;
  text-align:center;
}
.metric-val{
  font-family:'JetBrains Mono',monospace;
  font-size:22px;font-weight:500;
  color:var(--white);line-height:1;margin-bottom:4px;
}
.metric-val.good{color:var(--green);}
.metric-val.warn{color:var(--warn);}
.metric-label{font-size:10px;color:var(--text3);letter-spacing:0.5px;text-transform:uppercase;}
 
.app-ear-bar{padding:16px 20px;border-top:1px solid var(--border);}
.ear-header{display:flex;justify-content:space-between;margin-bottom:10px;}
.ear-title{font-size:11px;color:var(--text3);letter-spacing:0.5px;text-transform:uppercase;}
.ear-val{font-family:'JetBrains Mono',monospace;font-size:12px;color:var(--cyan);}
.ear-track{height:6px;background:var(--dark3);border-radius:3px;overflow:hidden;}
.ear-fill{height:100%;width:62%;background:linear-gradient(90deg,var(--accent),var(--cyan));border-radius:3px;animation:earPulse 3s ease-in-out infinite;}
@keyframes earPulse{0%,100%{width:62%;}50%{width:55%;}}
 
.app-btn-area{padding:14px 20px;border-top:1px solid var(--border);}
.app-launch-btn{
  width:100%;padding:12px;
  background:var(--accent);
  color:var(--white);
  font-size:13px;font-weight:600;
  border-radius:8px;border:none;cursor:pointer;
  font-family:'Inter',sans-serif;
  letter-spacing:0.3px;
}
 
/* Floating alert cards */
.alert-float{
  position:absolute;
  background:var(--card);
  border:1px solid var(--border2);
  border-radius:12px;
  padding:12px 16px;
  display:flex;align-items:center;gap:12px;
  box-shadow:0 8px 32px rgba(0,0,0,0.4);
  white-space:nowrap;
  font-size:13px;
}
.alert-float.f1{top:30px;right:-160px;animation:floatA 6s ease-in-out infinite;}
.alert-float.f2{bottom:120px;right:-140px;animation:floatB 7s ease-in-out infinite;}
.alert-float.f3{bottom:60px;left:-130px;animation:floatA 8s ease-in-out infinite;}
@keyframes floatA{0%,100%{transform:translateY(0);}50%{transform:translateY(-8px);}}
@keyframes floatB{0%,100%{transform:translateY(0);}50%{transform:translateY(6px);}}
 
.af-icon{font-size:22px;flex-shrink:0;}
.af-label{font-size:10px;color:var(--text3);}
.af-val{font-weight:600;color:var(--text);}
 
/* STATS BAR */
.stats-bar{
  background:var(--dark2);
  border-top:1px solid var(--border);
  border-bottom:1px solid var(--border);
  padding:40px;
}
.stats-inner{
  max-width:1280px;margin:0 auto;
  display:grid;grid-template-columns:repeat(4,1fr);
  gap:40px;
}
.stat-item{text-align:center;}
.stat-num{
  font-size:42px;font-weight:900;
  color:var(--white);letter-spacing:-2px;line-height:1;
  margin-bottom:8px;
}
.stat-num span{color:var(--accent2);}
.stat-desc{font-size:13px;color:var(--text3);line-height:1.5;}
 
/* SECTIONS */
.section{padding:100px 40px;max-width:1280px;margin:0 auto;}
.section-full{padding:100px 40px;background:var(--dark2);}
.section-full-inner{max-width:1280px;margin:0 auto;}
 
.section-label{
  display:inline-flex;align-items:center;gap:6px;
  font-size:12px;font-weight:600;
  color:var(--accent2);
  letter-spacing:1px;text-transform:uppercase;
  margin-bottom:16px;
}
.section-label::before{content:'';width:16px;height:2px;background:var(--accent2);border-radius:1px;}
 
h2{
  font-size:clamp(32px,4vw,48px);
  font-weight:800;letter-spacing:-1.5px;
  color:var(--white);line-height:1.1;
  margin-bottom:16px;
}
.section-desc{font-size:16px;color:var(--text2);max-width:560px;line-height:1.7;}
 
/* HOW IT WORKS */
.steps-grid{
  display:grid;grid-template-columns:repeat(3,1fr);
  gap:24px;margin-top:56px;
}
.step-card{
  background:var(--card);
  border:1px solid var(--border);
  border-radius:16px;
  padding:32px;
  position:relative;
  transition:all 0.2s;
}
.step-card:hover{border-color:var(--border2);transform:translateY(-4px);}
.step-card::before{
  content:'';position:absolute;top:0;left:0;right:0;height:2px;
  background:linear-gradient(90deg,var(--accent),var(--cyan));
  border-radius:16px 16px 0 0;opacity:0;transition:opacity 0.2s;
}
.step-card:hover::before{opacity:1;}
.step-num{
  font-size:11px;font-weight:700;color:var(--accent2);
  letter-spacing:2px;text-transform:uppercase;margin-bottom:20px;
  font-family:'JetBrains Mono',monospace;
}
.step-icon{font-size:36px;margin-bottom:20px;}
.step-title{font-size:20px;font-weight:700;color:var(--white);margin-bottom:12px;}
.step-desc{font-size:14px;color:var(--text2);line-height:1.7;}
 
/* FEATURES */
.features-grid{
  display:grid;grid-template-columns:repeat(3,1fr);
  gap:20px;margin-top:56px;
}
.feat-card{
  background:var(--card);border:1px solid var(--border);
  border-radius:14px;padding:28px;
  transition:all 0.2s;
}
.feat-card:hover{border-color:var(--border2);}
.feat-icon-wrap{
  width:44px;height:44px;border-radius:10px;
  background:rgba(37,99,235,0.12);
  border:1px solid rgba(37,99,235,0.2);
  display:flex;align-items:center;justify-content:center;
  font-size:20px;margin-bottom:16px;
}
.feat-title{font-size:16px;font-weight:700;color:var(--white);margin-bottom:8px;}
.feat-desc{font-size:13px;color:var(--text2);line-height:1.7;}
 
/* COMPATIBILITY */
.compat-grid{
  display:grid;grid-template-columns:repeat(2,1fr);
  gap:24px;margin-top:56px;
}
.compat-card{
  background:var(--card);border:1px solid var(--border);
  border-radius:16px;padding:32px;
  display:grid;grid-template-columns:auto 1fr;gap:24px;
  align-items:start;transition:all 0.2s;
}
.compat-card:hover{border-color:var(--border2);}
.compat-brand{
  width:56px;height:56px;
  background:var(--dark3);border:1px solid var(--border2);
  border-radius:12px;
  display:flex;align-items:center;justify-content:center;
  font-size:28px;flex-shrink:0;
}
.compat-name{font-size:20px;font-weight:700;color:var(--white);margin-bottom:4px;}
.compat-sub{font-size:13px;color:var(--text3);margin-bottom:16px;}
.compat-tags{display:flex;flex-wrap:wrap;gap:8px;}
.tag{
  font-size:11px;font-weight:500;
  padding:4px 10px;border-radius:6px;
  background:rgba(37,99,235,0.1);
  border:1px solid rgba(37,99,235,0.2);
  color:var(--accent2);
}
.tag.green{background:rgba(16,185,129,0.1);border-color:rgba(16,185,129,0.2);color:var(--green);}
.tag.cyan{background:rgba(6,182,212,0.1);border-color:rgba(6,182,212,0.2);color:var(--cyan);}
 
/* FLEET DASHBOARD */
.fleet-section{padding:100px 40px;}
.fleet-inner{max-width:1280px;margin:0 auto;}
.fleet-grid{display:grid;grid-template-columns:1fr 1.4fr;gap:60px;align-items:start;margin-top:56px;}
 
.fleet-points{display:flex;flex-direction:column;gap:24px;margin-top:32px;}
.fleet-point{display:flex;gap:16px;align-items:flex-start;}
.fp-icon{
  width:40px;height:40px;border-radius:10px;flex-shrink:0;
  background:rgba(37,99,235,0.1);border:1px solid rgba(37,99,235,0.2);
  display:flex;align-items:center;justify-content:center;font-size:18px;
}
.fp-title{font-size:15px;font-weight:600;color:var(--white);margin-bottom:4px;}
.fp-desc{font-size:13px;color:var(--text2);line-height:1.6;}
 
/* Dashboard UI */
.dashboard{
  background:var(--card);border:1px solid var(--border);
  border-radius:20px;overflow:hidden;
  box-shadow:0 40px 80px rgba(0,0,0,0.4);
}
.db-header{
  background:var(--dark3);
  padding:20px 24px;
  display:flex;align-items:center;justify-content:space-between;
  border-bottom:1px solid var(--border);
}
.db-title{font-size:15px;font-weight:700;color:var(--white);}
.db-live{display:flex;align-items:center;gap:6px;font-size:12px;color:var(--green);}
 
.db-summary{
  display:grid;grid-template-columns:repeat(4,1fr);
  gap:1px;background:var(--border);
  border-bottom:1px solid var(--border);
}
.db-sum-item{
  background:var(--dark2);
  padding:16px 20px;
}
.db-sum-val{font-size:24px;font-weight:800;color:var(--white);line-height:1;}
.db-sum-val.ok{color:var(--green);}
.db-sum-val.warn{color:var(--warn);}
.db-sum-val.danger{color:var(--danger);}
.db-sum-label{font-size:10px;color:var(--text3);margin-top:4px;text-transform:uppercase;letter-spacing:0.5px;}
 
.db-table-header{
  display:grid;grid-template-columns:2fr 1.2fr 1fr 1fr 1fr;
  padding:12px 24px;
  background:var(--dark3);
  border-bottom:1px solid var(--border);
  font-size:11px;color:var(--text3);
  text-transform:uppercase;letter-spacing:0.5px;
}
 
.db-row{
  display:grid;grid-template-columns:2fr 1.2fr 1fr 1fr 1fr;
  padding:14px 24px;
  border-bottom:1px solid rgba(30,45,74,0.5);
  align-items:center;
  transition:background 0.15s;
}
.db-row:hover{background:rgba(255,255,255,0.02);}
.db-row:last-child{border-bottom:none;}
 
.driver-info{display:flex;align-items:center;gap:10px;}
.driver-av{
  width:32px;height:32px;border-radius:50%;
  background:var(--dark3);border:1px solid var(--border2);
  display:flex;align-items:center;justify-content:center;
  font-size:14px;flex-shrink:0;
}
.driver-n{font-size:13px;font-weight:500;color:var(--text);}
.driver-id{font-size:11px;color:var(--text3);font-family:'JetBrains Mono',monospace;}
 
.db-cell{font-size:13px;color:var(--text2);}
.db-cell.mono{font-family:'JetBrains Mono',monospace;color:var(--text);}
 
.status-badge{
  display:inline-flex;align-items:center;gap:5px;
  font-size:11px;font-weight:600;
  padding:4px 10px;border-radius:6px;
  letter-spacing:0.3px;
}
.sb-ok{color:var(--green);background:rgba(16,185,129,0.1);border:1px solid rgba(16,185,129,0.2);}
.sb-warn{color:var(--warn);background:rgba(245,158,11,0.1);border:1px solid rgba(245,158,11,0.2);}
.sb-alert{color:var(--danger);background:rgba(239,68,68,0.1);border:1px solid rgba(239,68,68,0.2);}
.sb-rest{color:var(--text3);background:rgba(100,116,139,0.1);border:1px solid rgba(100,116,139,0.2);}
 
.db-ear-mini{
  width:60px;height:4px;background:var(--dark3);border-radius:2px;overflow:hidden;
}
.db-ear-fill{height:100%;border-radius:2px;}
 
/* WHO IT'S FOR */
.who-grid{
  display:grid;grid-template-columns:repeat(4,1fr);
  gap:20px;margin-top:56px;
}
.who-card{
  background:var(--card);border:1px solid var(--border);
  border-radius:14px;padding:28px 24px;text-align:center;
  transition:all 0.2s;
}
.who-card:hover{border-color:var(--border2);transform:translateY(-4px);}
.who-emoji{font-size:44px;margin-bottom:16px;display:block;}
.who-title{font-size:16px;font-weight:700;color:var(--white);margin-bottom:8px;}
.who-desc{font-size:13px;color:var(--text2);line-height:1.6;}
 
/* CTA */
.cta-section{
  background:linear-gradient(135deg,rgba(37,99,235,0.15),rgba(6,182,212,0.08));
  border-top:1px solid var(--border);
  border-bottom:1px solid var(--border);
  padding:100px 40px;
  text-align:center;
}
