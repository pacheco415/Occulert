{
  "expo": {
    "name": "Occulert",
    "slug": "occulert",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "appleTeamId": "W3W6Z8U68C",
      "bundleIdentifier": "com.occulert.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Occulert uses your front camera to detect eye fatigue while driving. No video is stored or uploaded.",
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#050a0f"
      },
      "package": "com.occulert.app",
      "permissions": [
        "CAMERA",
        "VIBRATE",
        "WAKE_LOCK",
        "FOREGROUND_SERVICE"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-status-bar",
      "expo-font",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#050a0f"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "scheme": "occulert",
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "69c230c1-c42a-4d83-b2a0-e1752e719b53"
      }
    }
  }
}
