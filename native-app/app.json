{
  "expo": {
    "name": "Occulert",
    "slug": "occulert",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "icon": "./assets/icon.png",
      "supportsTablet": false,
      "appleTeamId": "W3W6Z8U68C",
      "bundleIdentifier": "com.occulert.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Occulert uses your front camera for on-device fatigue monitoring. Optional parked setup tests briefly check both cameras. No photos or video are saved or uploaded.",
        "NSMotionUsageDescription": "Occulert reads motion from compatible connected headphones during foreground monitoring to record optional local-only head-movement observations. These observations do not change fatigue scores or alerts.",
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#050a0f"
      },
      "package": "com.occulert.app",
      "permissions": [
        "CAMERA",
        "VIBRATE",
        "WAKE_LOCK",
        "FOREGROUND_SERVICE"
      ]
    },
    "plugins": [
      "@bacons/apple-targets",
      "expo-router",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Occulert reads recent sleep and heart rate variability data to show optional pre-drive context. This data stays on this iPhone and does not change alerts.",
          "NSHealthUpdateUsageDescription": false,
          "background": false
        }
      ],
      "expo-status-bar",
      "expo-font",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#050a0f"
        }
      ],
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "scheme": "occulert",
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "69c230c1-c42a-4d83-b2a0-e1752e719b53"
      }
    }
  }
}
