{
  "name": "occulert-site",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "audit:site": "node scripts/audit-site.mjs",
    "test:api": "node scripts/test-api-security.mjs",
    "test:client": "node scripts/test-backend-client.mjs",
    "test:native-cloud": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/test-native-cloud-sync.mjs",
    "test:session-history-data": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test scripts/test-session-history-data.mjs",
    "test:high-fixes": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/test-high-security-fixes.mjs",
    "test:remaining-fixes": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test scripts/test-remaining-security-fixes.mjs",
    "test:pilot-insights": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test scripts/test-pilot-insights.mjs",
    "test:head-nod": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test scripts/test-head-nod-detector.mjs",
    "test:headphone-motion": "node --test scripts/test-headphone-motion.mjs",
    "test:sensor-fusion": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test scripts/test-sensor-fusion-observation.mjs",
    "test:fusion-validation": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test scripts/test-fusion-validation-summary.mjs",
    "test:health-readiness": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test scripts/test-health-readiness.mjs",
    "test:in-ear-alerts": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test scripts/test-in-ear-alerts.mjs",
    "test:alert-preferences": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test scripts/test-alert-preferences.mjs",
    "test:alert-sounds": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test scripts/test-alert-sounds.mjs",
    "test:alert-delivery": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test scripts/test-alert-delivery.mjs",
    "test:safe-stop": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test scripts/test-safe-stop-links.mjs",
    "test:monitor-lifecycle": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test scripts/test-monitor-lifecycle.mjs",
    "test:native-setup": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test scripts/test-native-setup-reliability.mjs scripts/test-device-readiness.mjs",
    "test:performance": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test scripts/test-performance-contracts.mjs",
    "test:native-perclos": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test scripts/test-native-perclos.mjs",
    "test:watch-status": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test scripts/test-watch-status.mjs",
    "test:fleet-history": "node --test scripts/test-fleet-session-history.mjs",
    "test:fleet-display": "node --test scripts/test-fleet-display.mjs",
    "test:pilot-launch": "node --test scripts/test-pilot-launch-checklist.mjs",
    "test:login": "node --test scripts/test-login-auth.mjs",
    "test:supabase-loader": "node --test scripts/test-supabase-loader.mjs",
    "test:passkeys": "node --test scripts/test-passkey-auth.mjs",
    "test:account": "node --test scripts/test-account-credentials.mjs",
    "test:account-delete": "node scripts/test-account-deletion.mjs && node scripts/test-account-deletion-db.mjs",
    "test:benchmark": "node benchmark/test-benchmark.mjs",
    "test:detection": "node --test scripts/test-detection-pipeline.mjs",
    "test:browser": "playwright test",
    "verify": "npm run audit:site && npm run test:mediapipe && npm run test:api && npm run test:client && npm run test:native-cloud && npm run test:session-history-data && npm run test:high-fixes && npm run test:remaining-fixes && npm run test:pilot-insights && npm run test:head-nod && npm run test:headphone-motion && npm run test:sensor-fusion && npm run test:fusion-validation && npm run test:health-readiness && npm run test:in-ear-alerts && npm run test:alert-preferences && npm run test:alert-sounds && npm run test:alert-delivery && npm run test:safe-stop && npm run test:monitor-lifecycle && npm run test:native-setup && npm run test:performance && npm run test:native-perclos && npm run test:watch-status && npm run test:fleet-history && npm run test:fleet-display && npm run test:pilot-launch && npm run test:login && npm run test:supabase-loader && npm run test:passkeys && npm run test:account && npm run test:account-delete && npm run test:benchmark && npm run test:detection && npm run test:fleet-followups && npm run test:fleet-indexes",
    "test:mediapipe": "node --test scripts/test-mediapipe-runtime.mjs",
    "test:fleet-followups": "node scripts/test-fleet-followups.mjs && node scripts/test-fleet-followups-db.mjs",
    "test:fleet-indexes": "node scripts/test-fleet-query-indexes.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "^1.54.1"
  },
  "engines": {
    "node": "24.x"
  }
}
