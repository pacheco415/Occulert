{
  "name": "occulert-native",
  "version": "1.0.0",
  "description": "Occulert native iOS and Android drowsiness detection app",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "build:dev": "eas build --profile development --platform ios",
    "build:ios": "eas build --platform ios",
    "build:android": "eas build --platform android",
    "submit:ios": "eas submit -p ios"
  },
  "dependencies": {
    "@bacons/apple-targets": "5.0.0",
    "@expo/vector-icons": "^15.0.3",
    "@kingstinct/react-native-healthkit": "14.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.9",
    "expo-asset": "~57.0.8",
    "expo-audio": "~57.0.3",
    "expo-constants": "~57.0.8",
    "expo-dev-client": "~57.0.10",
    "expo-font": "~57.0.1",
    "expo-glass-effect": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-keep-awake": "~57.0.1",
    "expo-linking": "~57.0.4",
    "expo-router": "~57.0.9",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-nitro-modules": "0.36.5",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-vision-camera": "^4.7.3",
    "react-native-vision-camera-face-detector": "^1.10.2",
    "react-native-watch-connectivity": "^2.0.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets-core": "^1.6.3"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "private": true
}
