{
  "name": "occulert-native",
  "version": "1.0.0",
  "description": "Occulert native iOS and Android drowsiness detection app",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "web": "expo start --web",
    "postinstall": "node ./scripts/patch-watch-connectivity.mjs && node ./scripts/patch-query-decoder.mjs && node ./scripts/patch-sdk58-camera.mjs && node ./scripts/patch-camera-multitasking.mjs",
    "check:dependencies": "expo install --check",
    "typecheck": "tsc --noEmit",
    "verify": "npm run check:dependencies && npm run typecheck && npm run test:dependencies && npm run test:camera-runtime && npm run test:audio-lifecycle && npm run test:history-interactions && npm run test:monitor-layout && npm run test:front-camera-identity && npm run test:front-camera-switch && npm run test:capture-load && npm run test:camera-interruptions",
    "build:dev": "eas build --profile development --platform ios",
    "build:ios": "eas build --platform ios",
    "build:android": "eas build --platform android",
    "submit:ios": "eas submit -p ios",
    "test:dependencies": "node --test scripts/test-dependency-compatibility.mjs",
    "test:camera-runtime": "node --test scripts/test-camera-runtime-compatibility.mjs",
    "test:audio-lifecycle": "node --test scripts/test-audio-lifecycle.mjs",
    "test:history-interactions": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test scripts/test-history-interactions.mjs",
    "test:monitor-layout": "node --test scripts/test-monitor-layout.mjs scripts/test-alert-layout.mjs",
    "test:front-camera-identity": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test scripts/test-front-camera-identity.mjs",
    "test:front-camera-switch": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test scripts/test-front-camera-switch.mjs",
    "test:capture-load": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test scripts/test-capture-load.mjs",
    "test:camera-interruptions": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test scripts/test-camera-interruptions.mjs"
  },
  "dependencies": {
    "@bacons/apple-targets": "5.0.0",
    "@expo/vector-icons": "^15.0.3",
    "@kingstinct/react-native-healthkit": "14.1.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.0",
    "expo-asset": "~58.0.18",
    "expo-audio": "~58.0.10",
    "expo-battery": "~58.0.3",
    "expo-build-properties": "~58.0.11",
    "expo-constants": "~58.0.13",
    "expo-dev-client": "~58.0.15",
    "expo-font": "~58.0.10",
    "expo-glass-effect": "~58.0.5",
    "expo-haptics": "~58.0.7",
    "expo-keep-awake": "~58.0.3",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.26",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-nitro-modules": "0.36.5",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-vision-camera": "4.7.3",
    "react-native-vision-camera-face-detector": "^1.10.2",
    "react-native-watch-connectivity": "^2.0.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets-core": "1.6.3"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-transform-react-jsx": "7.29.7",
    "@types/react": "~19.3.0",
    "react-test-renderer": "19.3.0",
    "typescript": "~6.0.3",
    "yoga-layout": "3.2.1"
  },
  "private": true,
  "overrides": {
    "@bacons/xcode": {
      "uuid": "11.1.1"
    },
    "xcode": {
      "uuid": "11.1.1"
    },
    "query-string": {
      "decode-uri-component": "0.5.0"
    },
    "react-devtools-core": {
      "shell-quote": "1.12.0"
    },
    "@xmldom/xmldom@<0.8.15": "0.8.15"
  }
}
