{
  "cli": {
    "version": ">= 10.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "resourceClass": "m-medium"
      }
    },
    "preview": {
      "distribution": "internal"
    },
    "simulator-trace": {
      "distribution": "internal",
      "env": {
        "OCCULERT_SIMULATOR_TRACE": "1",
        "OCCULERT_SIMULATOR_PROFILE": "simulator-trace",
        "OCCULERT_SIMULATOR_PLATFORM": "ios"
      },
      "ios": {
        "simulator": true,
        "buildConfiguration": "Release",
        "image": "sdk-58"
      }
    },
    "production": {
      "autoIncrement": true,
      "ios": {
        "image": "sdk-58"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6787265375"
      }
    }
  }
}
